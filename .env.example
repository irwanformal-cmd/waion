# Copy to .env.local for development. NEVER commit real secrets.
# Generate secrets with: openssl rand -base64 32

# --- Database (PostgreSQL) ---
# Local dev (docker compose): postgresql://app:app_password@localhost:5432/ai_startup
DATABASE_URL=postgresql://user:password@localhost:5432/ai_startup

# --- Authentication ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- AI provider ---
# Allowlisted values: openai | anthropic | google | openai-compatible
AI_PROVIDER=openai
# Allowlisted model for the provider
AI_MODEL=gpt-4o-mini
# Server-side only. NEVER expose to the browser.
AI_API_KEY=

# --- Application ---
# Public base URL of the app (used for cookies, links, CORS checks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated list of trusted origins allowed to call the API (CORS allowlist).
# Same-origin requests are always allowed. Leave empty for same-origin only.
TRUSTED_ORIGINS=

# --- Limits (server-enforced) ---
# Free-tier daily token budget; per-request input/output caps.
FREE_DAILY_TOKEN_BUDGET=100000
MAX_REQUEST_TOKENS=64000
MAX_MESSAGE_LENGTH=16000

# --- Logging ---
LOG_LEVEL=info# --- Email (verification / password reset). Optional in dev (logs URLs instead). ---
RESEND_API_KEY=
RESEND_FROM=
